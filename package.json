{
  "name": "character-creator",
  "private": true,
  "version": "2.0.0-alpha.0",
  "description": "D&D 5th Edition Character Creator - data from 5etools",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm coverage",
    "pull-data": "node scripts/pull-data.mjs",
    "build-base": "node scripts/build-base.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify:content": "node scripts/verify-content.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^26.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "supabase": "3.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.0"
  }
}
